# Leave these unset to run locally with zero setup: notes are saved to .data/dev-db.json
# and live updates go through a built-in dev relay (single server process only).

# Supabase project URL and keys (Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key: used in the browser for Realtime only (it can't read the tables).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
